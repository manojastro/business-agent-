# Metric Investigator configuration. Copy to .env and replace every "change-me" value.
# Never commit .env. Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- application ----
APP_ENV=development                      # development | test | production
APP_BASE_URL=http://localhost:8080
SESSION_SECRET=change-me-generate-a-long-random-value
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TRUSTED_PROXIES=127.0.0.1
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=1048576
DEMO_AS_OF_DATE=2026-09-01               # fixed as-of date so the synthetic history always works

# ---- databases (application and analytics are separate databases + separate credentials) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-bootstrap-superuser
DB_PORT=55432
APP_DB_USER=mi_app
APP_DB_PASSWORD=change-me-app
ANALYTICS_OWNER_USER=mi_analytics_owner
ANALYTICS_OWNER_PASSWORD=change-me-owner
ANALYTICS_READER_USER=mi_analytics_reader
ANALYTICS_READER_PASSWORD=change-me-reader
# Host-side URLs (used by uv run ... on your machine). Containers override the host to "db".
APP_DATABASE_URL=postgresql+psycopg://mi_app:change-me-app@127.0.0.1:55432/metric_app
ANALYTICS_DATABASE_URL=postgresql+psycopg://mi_analytics_reader:change-me-reader@127.0.0.1:55432/metric_analytics
ANALYTICS_OWNER_DATABASE_URL=postgresql+psycopg://mi_analytics_owner:change-me-owner@127.0.0.1:55432/metric_analytics

# ---- model provider ----
MODEL_MODE=fixture                       # fixture (deterministic "Demo simulation", no credentials) | real
MODEL_PROVIDER=azure_openai              # azure_openai | openai_compatible   (used when MODEL_MODE=real)
MODEL_NAME=                              # Azure deployment name or model id; required for real mode
MODEL_ENDPOINT=                          # e.g. https://<resource>.openai.azure.com  or  https://api.example.com/v1
MODEL_API_KEY=                           # placeholder only - never commit a real key
MODEL_API_VERSION=2024-10-21             # Azure OpenAI data-plane API version
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_INPUT_COST_PER_1K=0                # set from your provider's current price sheet; no prices are hardcoded
MODEL_OUTPUT_COST_PER_1K=0

# ---- investigation budgets and source safety ----
MAX_RUN_COST=0.50                        # per-investigation model cost ceiling (in the currency of the prices above)
MAX_SOURCE_QUERIES=12
MAX_HYPOTHESES=8
SOURCE_STATEMENT_TIMEOUT_MS=5000
SOURCE_MAX_ROWS=500
SOURCE_MAX_RESULT_BYTES=262144

# ---- worker ----
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=10

# ---- demo bootstrap (seed command). Leave empty to generate random passwords that are printed once. ----
DEMO_USER_PASSWORD=

# ---- optional telemetry (disabled unless an endpoint is set) ----
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- reverse proxy / TLS (production) ----
SITE_ADDRESS=:8080                       # set to your domain (e.g. metrics.example.com) to get automatic TLS from Caddy
